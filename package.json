{
  "name": "adify",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @adify/web",
    "build": "npm run build --workspace @adify/web",
    "check": "npm run check --workspace @adify/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run test:e2e --workspace @adify/web --",
    "test:e2e:install": "npm exec --workspace @adify/web -- playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.46.0"
  }
}
