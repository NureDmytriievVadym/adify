# Optional Docker Compose overrides. Never commit real credentials.
POSTGRES_DB=adify
POSTGRES_USER=adify
POSTGRES_PASSWORD=adify-local-only
WEB_PORT=5173
API_PORT=8000
MAILPIT_PORT=8025

# Send verification email through Gmail (Google Workspace) instead of Mailpit.
# Use an app password; SMS codes still go to the development outbox.
# ADIFY_SMTP_HOST=smtp.gmail.com
# ADIFY_SMTP_PORT=587
# ADIFY_SMTP_STARTTLS=true
# ADIFY_SMTP_USERNAME=adify@your-workspace-domain
# ADIFY_SMTP_PASSWORD=app-password
# ADIFY_MAIL_FROM=Adify <adify@your-workspace-domain>

# Payments (ADY-020) use the local Mono mock by default: http://localhost:8095, any
# Luhn-valid card number. Nothing to configure, no token needed.
MONO_MOCK_PORT=8095

# Optional evidence malware scanner (FR-041). The API has a built-in EICAR signature
# check; for full ClamAV scanning start `docker compose --profile malware up` with
# ADIFY_CLAMAV_HOST=clamav in your shell or .env.
# ADIFY_CLAMAV_HOST=clamav
# ADIFY_CLAMAV_PORT=3310
# CLAMAV_PORT=3310
# Only to try real Mono: a token from https://api.monobank.ua/ is a personal token that can
# read its owner's statement, so keep it in your own .env and never share or commit it.
# Leave ADIFY_API_PUBLIC_URL empty (no webhook) unless you run an HTTPS tunnel to the API;
# the order page then reads the invoice status from Mono after payment.
# ADIFY_MONO_API_URL=https://api.monobank.ua
# ADIFY_MONO_TOKEN=your-own-token
# ADIFY_API_PUBLIC_URL=
